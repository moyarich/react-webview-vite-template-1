{
  "name": "react-webview-vite-template-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:main": "npm run dev --workspace react-webview-vite-main",
    "dev:multi-webview": "npm run dev --workspace react-webview-vite-feat-multi-webview-template"
  }
}
