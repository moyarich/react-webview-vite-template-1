{
  "name": "react-webview-vite-templates",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "workspaces:run": "node ./scripts/run-workspaces.mjs",
    "dev:single": "npm run dev --workspace react-webview-vite-single-webview",
    "dev:separate-ui": "npm run dev --workspace react-webview-vite-separate-webview-ui",
    "dev:multi": "npm run dev --workspace react-webview-vite-multi-webview",
    "dev:scaffold": "npm run dev --workspace react-webview-vite-scaffold"
  },
  "bin": {
    "run-workspaces": "./scripts/run-workspaces.mjs"
  },
  "devDependencies": {
    "commander": "^15.0.0",
    "fzf": "^0.5.2"
  }
}
