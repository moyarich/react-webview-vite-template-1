{
  "name": "react-webview-vite",
  "displayName": "React Webview Vite",
  "description": "A minimal VS Code extension with a React, Vite, and Tailwind CSS webview in a separate webview-ui package.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "react-webview-vite.openPanel",
        "title": "Open React Webview"
      }
    ]
  },
  "scripts": {
    "postinstall": "npm ci --prefix webview-ui",
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "npm --prefix webview-ui run build",
    "watch": "concurrently -k -n extension,webview \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "vite build --watch --mode development --config vite.extension.config.ts",
    "watch:webview": "npm --prefix webview-ui run build:watch",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit && npm --prefix webview-ui run typecheck",
    "lint": "eslint src && npm --prefix webview-ui run lint"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.10"
  }
}
