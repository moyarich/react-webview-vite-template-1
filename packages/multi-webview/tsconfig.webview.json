{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/webviews/**/*.ts",
    "src/webviews/**/*.tsx",
    "src/webviews/**/*.d.ts"
  ],
  "exclude": [
    "src/extension.ts",
    "src/extension/**",
    "src/test/**",
    "node_modules",
    "out"
  ]
}
