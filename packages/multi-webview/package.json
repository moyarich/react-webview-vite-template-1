{
  "name": "react-webview-vite-multi-webview",
  "displayName": "React Webview Vite Template",
  "description": "A VS Code extension template for multiple React, Vite, and Tailwind CSS webviews with shared UI, theme, and messaging infrastructure.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "react-webview-vite.openDashboard",
        "title": "Open React Dashboard"
      },
      {
        "command": "react-webview-vite.openSettings",
        "title": "Open React Settings"
      }
    ],
    "submenus": [
      {
        "id": "react-webview-vite.webviewMenu",
        "label": "React Webviews"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "react-webview-vite.webviewMenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "react-webview-vite.webviewMenu",
          "group": "navigation"
        }
      ],
      "react-webview-vite.webviewMenu": [
        {
          "command": "react-webview-vite.openDashboard",
          "group": "navigation@1"
        },
        {
          "command": "react-webview-vite.openSettings",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "concurrently -k -n extension,webview \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "vite build --watch --mode development --config vite.extension.config.ts",
    "watch:webview": "vite build --watch --mode development --config vite.webview.config.ts",
    "dev": "concurrently -k -n extension,webview,preview,vscode \"npm run watch:extension\" \"npm run watch:webview\" \"npm run dev:preview\" \"npm run dev:extension\"",
    "dev:preview": "vite --config vite.webview.config.ts --host 127.0.0.1 --open /previews/dashboard.html",
    "dev:extension": "node ./scripts/run-extension-dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.webview.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "22.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.118.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.10"
  },
  "private": true
}
