{
  "name": "react-webview-vite-scaffold",
  "displayName": "react-webview-vite",
  "description": "webview",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "react-webview-vite.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "react-webview-vite.openPanel",
        "title": "Open React Webview"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "concurrently -k -n extension,webview \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:webview": "npm --prefix webview-ui run build -- --watch",
    "dev": "npm run dev:preview",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "watch:extension": "tsc -watch -p ./",
    "dev:preview": "npm --prefix webview-ui run dev"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "private": true
}
